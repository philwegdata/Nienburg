{
  "name": "nienburg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cozy, turn-based medieval city builder for the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
